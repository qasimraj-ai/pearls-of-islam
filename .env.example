# Copy this file to .env.local and set the address of your lecture server.
# Example for running the server on your own computer:
VITE_API_URL=https://localhost:8787.com

# Google and Apple sign-in (optional, see README; not connected yet)
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_APPLE_CLIENT_ID=your.apple.services.id

# Server settings (set these where the server runs, not in .env.local)
# PORT=8787
# DATA_DIR=./server/data
# ADMIN_EMAIL=you@example.com
# CORS_ORIGIN=https://your-website.example
# SESSION_DAYS=90
